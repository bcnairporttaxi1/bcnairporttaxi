{
  "name": "bcnairporttaxi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "gen:images": "tsx scripts/generate-images.ts",
    "gen:art": "tsx scripts/make-fleet-art.ts",
    "seo:audit": "tsx scripts/seo-audit.ts",
    "verify:payment": "tsx scripts/verify-payment-flow.ts",
    "admin": "tsx scripts/create-admin.ts",
    "postinstall": "prisma generate",
    "verify:rides": "tsx --env-file=.env scripts/verify-ride-flow.ts",
    "admin:reset": "tsx --env-file=.env scripts/reset-admin-password.ts",
    "ci": "tsc --noEmit && eslint src && vitest run",
    "verify:emails": "tsx --env-file=.env scripts/verify-emails.ts"
  },
  "dependencies": {
    "@date-fns/tz": "^1.4.1",
    "@google/genai": "^2.16.0",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.2",
    "date-fns": "^4.1.0",
    "jose": "^6.1.0",
    "leaflet": "^1.9.4",
    "next": "16.3.0",
    "next-intl": "^4.13.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "^5.0.0",
    "resend": "^6.18.1",
    "server-only": "^0.0.1",
    "ws": "^8.21.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
