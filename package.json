{
  "name": "bcnairporttaxi",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@bcn/web",
    "build": "npm run build --workspace=@bcn/web",
    "build:ci": "npm run build:ci --workspace=@bcn/web",
    "start": "npm run start --workspace=@bcn/web",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "tsc --noEmit --project apps/web/tsconfig.json",
    "ci": "npm run typecheck && npm run lint && npm run test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "devDependencies": {
    "dotenv": "^17.2.3",
    "prisma": "^7.9.1",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
