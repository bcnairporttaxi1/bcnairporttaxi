// BCNAirportTaxi — data model
// Booking intermediary: we collect a 20% booking fee online; the metered fare is
// settled with the driver in the taxi. Nothing here stores card data.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  DRIVER
  ADMIN
}

/// The lifecycle a ride moves through. EN_ROUTE onwards is driven by the four
/// buttons in the driver panel, so each transition is a real event with a
/// timestamp rather than a status someone set by hand.
enum BookingStatus {
  PENDING // created, booking fee not yet paid
  CONFIRMED // booking fee paid
  ASSIGNED // driver attached
  EN_ROUTE // driver on the way
  ARRIVED // driver waiting at the pickup point
  ON_BOARD // passenger in the car
  COMPLETED
  CANCELLED
}

/// How a driver wants to be paid out for prepaid rides.
enum PayoutMethod {
  BIZUM
  BANK
}

enum WithdrawalStatus {
  REQUESTED
  APPROVED
  PAID
  REJECTED
}

/// Who a rating was written by. A booking can hold one of each.
enum RatingDirection {
  USER_TO_DRIVER
  DRIVER_TO_USER
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

/// FEE_ONLY: 20% booking fee online, metered fare paid to the driver in the car.
/// FULL_PREPAID: fixed fare + booking fee online, nothing owed in the taxi.
enum PaymentMode {
  FEE_ONLY
  FULL_PREPAID
}

/// Urban (AMB): T-1 daytime weekday, T-2 night/weekend/holiday, T-4 the fixed
/// airport <-> Moll Adossat price.
/// Interurban (Generalitat, outside the AMB): T-6 daytime weekday, T-7 nights,
/// weekends and holidays.
/// Stored so a historic booking always explains the estimate it was quoted,
/// even after tariffs change.
enum Tariff {
  T1
  T2
  T4
  T6
  T7
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  phone        String?
  /// Shown to the driver of an active ride so they can reach the passenger.
  whatsapp     String?
  passwordHash String
  role         Role      @default(USER)
  locale       String    @default("en")
  lastSeenAt   DateTime?

  /// Accounts opened by an admin get a generated password mailed to them, and
  /// cannot reach anything but the change-password screen until they replace it.
  mustChangePassword Boolean   @default(false)
  passwordChangedAt  DateTime?

  /// Set by an admin after an upheld report. Blocks login.
  blocked       Boolean @default(false)
  blockedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[] @relation("UserBookings")
  driver   Driver?
  messages Message[]
  reviews  Review[]

  reportsMade     Report[] @relation("ReportsByUser")
  reportsReceived Report[] @relation("ReportsAgainstUser")

  @@index([role])
  @@index([createdAt])
  @@index([blocked])
}

model Driver {
  id            String  @id @default(cuid())
  userId        String? @unique
  user          User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  name          String
  phone         String
  /// Passengers on an active ride see this alongside the phone number.
  whatsapp      String?
  licenseNumber String
  /// Registration plate, shown to the passenger so they identify the right car.
  plate         String?
  photoUrl      String?
  active        Boolean @default(true)

  /// Set by an admin after an upheld report. Blocks login and new assignments.
  blocked       Boolean @default(false)
  blockedReason String?

  // Where prepaid earnings are sent. Bizum needs only a phone; a transfer needs
  // the IBAN and the name on the account.
  payoutMethod     PayoutMethod?
  payoutBizumPhone String?
  payoutIban       String?
  payoutHolder     String?

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  bookings    Booking[]    @relation("DriverBookings")
  withdrawals Withdrawal[]

  reportsMade     Report[] @relation("ReportsByDriver")
  reportsReceived Report[] @relation("ReportsAgainstDriver")
  ratings         Review[] @relation("DriverRatings")

  @@index([active])
  @@index([createdAt])
  @@index([blocked])
}

model Vehicle {
  id       String @id @default(cuid())
  slug     String @unique
  name     String
  category String
  seats    Int
  bags     Int
  imageUrl String
  imageAlt String
  /// Ordering weight for the fleet picker.
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  drivers  Driver[]
  bookings Booking[]

  @@index([active, sortOrder])
}

model Booking {
  id        String @id @default(cuid())
  reference String @unique

  userId String?
  user   User?   @relation("UserBookings", fields: [userId], references: [id], onDelete: SetNull)

  // Contact details captured at booking time (guest checkout allowed).
  contactName  String
  contactEmail String
  contactPhone String

  // Route
  pickupLabel  String
  pickupLat    Float
  pickupLng    Float
  dropoffLabel String
  dropoffLat   Float
  dropoffLng   Float
  roadKm       Float
  durationMin  Int

  // Quote — every component stored so the price is reproducible after the
  // tariff table changes, and so disputes can be settled from the record.
  tariff          Tariff
  startFare       Decimal @db.Decimal(10, 2)
  /// Official AMB rate used for the meter estimate.
  perKmRate       Decimal @db.Decimal(10, 4)
  /// Rate we actually charged on the fixed fare (official + markup).
  perKmRateCharged Decimal @db.Decimal(10, 4)
  supplements     Decimal @db.Decimal(10, 2)
  /// What the taxi meter is expected to read.
  meterEstimate   Decimal @db.Decimal(10, 2)
  /// Our locked prepaid fare.
  fixedFare       Decimal @db.Decimal(10, 2)
  bookingFee      Decimal @db.Decimal(10, 2)
  /// Amount actually taken online, derived from paymentMode.
  amountOnline    Decimal @db.Decimal(10, 2)
  currency        String  @default("EUR")

  paymentMode PaymentMode @default(FEE_ONLY)

  pickupAt   DateTime
  passengers Int      @default(1)
  luggage    Int      @default(0)
  notes      String?

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  driverId String?
  driver   Driver? @relation("DriverBookings", fields: [driverId], references: [id], onDelete: SetNull)

  status          BookingStatus @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  sumupRef        String?
  sumupCheckoutId String?

  // Ride timeline. Each is stamped by the matching driver-panel button, so the
  // admin ride view can show what happened and when without guessing.
  enRouteAt   DateTime?
  arrivedAt   DateTime?
  onBoardAt   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?
  /// USER, DRIVER or ADMIN — passengers cannot cancel, so in practice ADMIN.
  cancelledBy Role?
  cancelReason String?

  /// Passengers may change the route or details until this moment — 30 minutes
  /// from booking, and never after a driver is on the way.
  editableUntil DateTime?

  /// Stamped once the "driver is at your door" mail goes out, so the proximity
  /// check cannot send it twice.
  atDoorNotifiedAt DateTime?

  /// What the platform owes this driver for the ride. Non-zero only when the
  /// passenger prepaid, because otherwise the driver takes the fare in the car.
  driverPayout  Decimal  @default(0) @db.Decimal(10, 2)
  /// What the driver must still collect in the taxi. Zero when fully prepaid.
  cashToCollect Decimal  @default(0) @db.Decimal(10, 2)
  /// Confirmed by the driver on completion.
  cashCollected Boolean  @default(false)

  // Live location is opt-in on both sides and can be revoked mid-trip.
  userSharesLocation   Boolean @default(false)
  driverSharesLocation Boolean @default(false)

  locale    String   @default("en")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages      Message[]
  reviews       Review[]
  reports       Report[]
  locationPings LocationPing[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([driverId, status])
  @@index([pickupAt])
  @@index([sumupCheckoutId])
  @@index([status, pickupAt])
}

model Message {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  senderRole Role
  senderId   String?
  sender     User?   @relation(fields: [senderId], references: [id], onDelete: SetNull)

  body String

  /// True once the message was mirrored to email because the recipient was offline.
  deliveredEmail Boolean   @default(false)
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([bookingId, createdAt])
}

/// One row per rating, in either direction. A completed ride can carry two:
/// the passenger rating the driver and the driver rating the passenger. Only
/// passenger-to-driver ratings are ever eligible for the public reviews page.
model Review {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  direction RatingDirection @default(USER_TO_DRIVER)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  driverId String?
  driver   Driver? @relation("DriverRatings", fields: [driverId], references: [id], onDelete: SetNull)

  authorName String
  rating     Int
  text       String
  /// Admin moderation gate — only approved reviews feed AggregateRating JSON-LD.
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([bookingId, direction])
  @@index([approved, createdAt])
  @@index([rating])
  @@index([driverId, createdAt])
  @@index([direction, createdAt])
  // The driver panel averages one direction for one driver.
  @@index([driverId, direction])
}

/// A complaint raised by one party about the other on a specific ride.
model Report {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  reporterRole Role

  byUserId String?
  byUser   User?   @relation("ReportsByUser", fields: [byUserId], references: [id], onDelete: SetNull)

  byDriverId String?
  byDriver   Driver? @relation("ReportsByDriver", fields: [byDriverId], references: [id], onDelete: SetNull)

  againstUserId String?
  againstUser   User?   @relation("ReportsAgainstUser", fields: [againstUserId], references: [id], onDelete: SetNull)

  againstDriverId String?
  againstDriver   Driver? @relation("ReportsAgainstDriver", fields: [againstDriverId], references: [id], onDelete: SetNull)

  reason  String
  details String?

  status     ReportStatus @default(OPEN)
  adminNotes String?
  resolvedAt DateTime?
  createdAt  DateTime     @default(now())

  @@index([status, createdAt])
  @@index([bookingId])
}

/// A driver asking to be paid the prepaid earnings sitting in their balance.
model Withdrawal {
  id       String @id @default(cuid())
  driverId String
  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  amount Decimal      @db.Decimal(10, 2)
  method PayoutMethod
  /// Snapshot of where the money was sent, so changing payout details later
  /// does not rewrite the history of past payouts.
  destination String

  status     WithdrawalStatus @default(REQUESTED)
  adminNotes String?
  reference  String?
  requestedAt DateTime        @default(now())
  processedAt DateTime?

  @@index([driverId, requestedAt])
  @@index([status, requestedAt])
  // driverBalance filters on both at once to work out what is still held.
  @@index([driverId, status])
}

/// Trail for admin actions that change or remove data, including bulk ones.
model AuditLog {
  id      String @id @default(cuid())
  actorId String?
  actorEmail String
  action  String
  /// Comma-separated booking references or ids the action touched.
  target  String
  detail  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model LocationPing {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  role Role
  lat  Float
  lng  Float
  ts   DateTime @default(now())

  @@index([bookingId, role, ts])
}
