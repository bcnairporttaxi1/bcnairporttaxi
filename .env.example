# ---- Database (Neon Postgres) ----
DATABASE_URL=

# ---- Email (Resend) ----
RESEND_API_KEY=
# Must be a verified sending domain in production.
RESEND_FROM="BCNAirportTaxi <bookings@yourdomain.com>"

# ---- Gemini image generation (build-time only, `npm run gen:images`) ----
# Three keys enable automatic failover on 429 / RESOURCE_EXHAUSTED.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# ---- Payments (SumUp) — booking fee only, never the metered fare ----
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=

# ---- Public site config ----
# WhatsApp number in international format, no +, e.g. 34600123456
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_SITE_URL=https://bcnairporttaxi.com

# ---- Geocoding + routing ----
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OSRM_BASE_URL=https://router.project-osrm.org

# ---- Auth ----
# Generate with: openssl rand -base64 32
AUTH_SECRET=
